<%= title l(:label_administration), l(:label_project_modules) %>

<span class="pagination"><%= pagination_links_full @project_pages, @project_count %></span>

<%= form_tag(project_modules_path, method: :patch) do %>
  <% if params[:page].present? %>
    <%= hidden_field_tag :page, params[:page] %>
  <% end %>

  <div class="autoscroll">
    <table class="list permissions">
      <thead>
        <tr>
          <th><%= l(:label_project) %></th>
          <% @available_modules.each do |project_module| %>
            <% module_key = project_module.to_s.tr('_', '-').downcase %>
            <th>
              <%= l_or_humanize(project_module, prefix: 'project_module_') %><br>
              <%= button_tag l(:label_enable_all), type: 'button', class: 'js-project-module-column-toggle', data: { module_key: module_key, checked: '1' } %>
              <%= button_tag l(:label_disable_all), type: 'button', class: 'js-project-module-column-toggle', data: { module_key: module_key, checked: '0' } %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @projects.each do |project| %>
          <tr class="<%= cycle('odd', 'even') %>">
            <td class="name"><%= link_to_project(project) %></td>
            <% @available_modules.each do |project_module| %>
              <% module_key = project_module.to_s.tr('_', '-').downcase %>
              <td class="center">
                <%= check_box_tag(
                  "project_modules[#{project.id}][#{project_module}]",
                  '1',
                  project.module_enabled?(project_module),
                  class: "js-project-module-column-#{module_key}"
                ) %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <p><%= submit_tag l(:button_save) %></p>
<% end %>

<span class="pagination"><%= pagination_links_full @project_pages, @project_count %></span>

<%= javascript_tag do %>
  if (!window.projectModuleColumnToggleBound) {
    document.addEventListener('click', function(event) {
      var button = event.target.closest('.js-project-module-column-toggle');
      if (!button) { return; }

      var moduleKey = button.dataset.moduleKey;
      var checked = button.dataset.checked === '1';
      document.querySelectorAll('.js-project-module-column-' + moduleKey).forEach(function(checkbox) {
        checkbox.checked = checked;
      });
    });
    window.projectModuleColumnToggleBound = true;
  }
<% end %>
